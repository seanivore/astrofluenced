{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<your-github-token>"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/seanivore/Desktop",
        "/Users/seanivore/Library/Application Support/Claude",
        "/Users/seanivore/Development",
        "/Users/seanivore/Dropbox/Workspaces"
      ]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "/Users/seanivore/Development/"
      ]
    },
    "terminal": {
      "command": "node",
      "args": ["/Users/seanivore/Development/terminal/dist/index.js"],
      "env": {
        "PERMISSION_REQUIRED": "true"
      }
    },
    "web-browser-mcp-server": {
      "command": "uv",
      "args": ["tool", "run", "web-browser-mcp-server"],
      "env": {
        "REQUEST_TIMEOUT": "30"
      }
    },
    "fetch": {
      "command": "node",
      "args": ["/Users/seanivore/Development/fetch-mcp/dist/index.js"]
    },
    "cyberchitta": {
      "command": "uvx",
      "args": ["--from", "llm-context", "lc-mcp"]
    },
    "md-pdf-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "/Users/seanivore/Development/md-pdf-mcp",
        "run",
        "md-pdf-mcp"
      ]
    },
    "Claude Remembers": {
      "command": "node",
      "args": [
        "/Users/seanivore/Development/claude-remembers-you/vector-brain/build/index.js"
      ]
    }
  }
}
