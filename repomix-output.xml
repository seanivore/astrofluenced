<file path="extract_urls.py">
import os
import re

# Set the directory containing your HTML files
html_dir = "/Users/seanivore/Development/astrofluenced"
output_file = "/Users/seanivore/Development/astrofluenced/urls.txt"

# Regex to match asset URLs
url_patterns = [
    r'<link[^>]+href="([^"]+)"',
    r'<img[^>]+src="([^"]+)"',
    r'<script[^>]+src="([^"]+)"',
    r'data-src="([^"]+)"',
    r'href="([^"]+\.lottie)"'
]

# Set to store unique URLs
urls = set()

# Iterate through all .html files
for root, _, files in os.walk(html_dir):
    for file in files:
        if file.endswith(".html"):
            with open(os.path.join(root, file), "r", encoding="utf-8") as f:
                content = f.read()
                for pattern in url_patterns:
                    matches = re.findall(pattern, content)
                    urls.update(matches)

# Write URLs to the output file
with open(output_file, "w") as f:
    for url in sorted(urls):
        if url.startswith("http"):
            f.write(url + "\n")

print(f"Extracted {len(urls)} unique URLs. Saved to {output_file}.")
</file>

